# Calendar or application URL shown after a qualified lead receives a result.
LES_AION_BOOKING_URL=https://example.com/book

# Deployed Google Apps Script web app used for free/busy lookup and booking.
LES_AION_GOOGLE_SCRIPT_URL=
# Optional for the initial private-server integration; recommended before paid traffic.
LES_AION_BOOKING_SECRET=

# Optional HTTPS endpoint (CRM, Google Apps Script, Make, Zapier, etc.).
# It receives the submitted answers, UTM source, score and generated brief as JSON.
LES_AION_LEAD_WEBHOOK_URL=

# Existing LES AION AI features. Keep server-side only.
OPENAI_API_KEY=
CONTENT_API_SECRET=
